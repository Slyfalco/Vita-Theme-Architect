// VitaTheme Architect v3: main window.

import { Palette, Type, Density } from "palette.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";
import { Shell, Library, Page, ThemeRow, ThemeDetail } from "state.slint";
import { TitleBar, NavRail, Breadcrumb } from "shell.slint";
import { LibraryPage } from "library.slint";
import { Splash } from "splash.slint";

export { Palette, Shell, Library, Page, ThemeRow, ThemeDetail, Splash }

import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

component Placeholder inherits Rectangle {
    in property <string> title;
    in property <string> note;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: root.title;
            color: Palette.text-hi;
            font-size: Type.headline-xl;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.note;
            color: Palette.text-mid;
            font-size: Type.body-md;
            horizontal-alignment: center;
        }
    }
}

// Invisible strips along the window edges for resizing a frameless window.
component ResizeEdge inherits TouchArea {
    in property <string> edge;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            Shell.start-resize(root.edge);
        }
    }
}

export component AppWindow inherits Window {
    title: "VitaTheme Architect";
    icon: @image-url("../../../Assets/app_icon.png");
    no-frame: !Shell.native-frame;
    // A 4K screen at 300% is 1280x720 logical *including* the taskbar, so the
    // minimum has to sit below that; compact/narrow density keeps it usable.
    min-width: 1100px;
    min-height: 620px;
    preferred-width: 1600px;
    preferred-height: 960px;
    background: Palette.canvas;
    default-font-family: Palette.ui-font;
    default-font-size: Type.body-md;

    function update-density() {
        Density.compact = root.height < 860px;
        Density.narrow = root.width < 1500px;
    }
    init => { root.update-density(); }
    changed width => { root.update-density(); }
    changed height => { root.update-density(); }

    property <string> page-title: Shell.page == Page.library ? "Theme Library"
        : Shell.page == Page.creator ? "Theme Creator"
        : Shell.page == Page.community ? "Community Browser" : "Settings";

    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "n" || event.text == "N") { Shell.new-theme(); return accept; }
                if (Shell.page == Page.library) {
                    if (event.modifiers.shift && (event.text == "i" || event.text == "I")) { Library.import-multiple(); return accept; }
                    if (event.text == "i" || event.text == "I") { Library.import-zip(); return accept; }
                    if (event.text == "f" || event.text == "F") { library.focus-search(); return accept; }
                    if (event.text == "v" || event.text == "V") { Library.import-from-vita(); return accept; }
                    if (event.text == "d" || event.text == "D") { Shell.navigate(Page.community); return accept; }
                    if (Library.selected >= 0) {
                        if (event.text == "e" || event.text == "E") { Library.edit(Library.selected); return accept; }
                        if (event.text == "s" || event.text == "S") { Library.send-to-vita(Library.selected); return accept; }
                        if (event.text == "x" || event.text == "X") { Library.extract-bgm(Library.selected); return accept; }
                        if (event.text == "p" || event.text == "P") { Library.bgm-toggle-play(); return accept; }
                    }
                }
            }
            if (Shell.page == Page.library && Library.selected >= 0) {
                if (event.text == Key.Delete) { Library.delete(Library.selected); return accept; }
                if (event.text == Key.UpArrow && Library.selected > 0) { Library.select(Library.selected - 1); return accept; }
                if (event.text == Key.DownArrow && Library.selected < Library.themes.length - 1) { Library.select(Library.selected + 1); return accept; }
            }
            reject
        }

        // Optional app-theme backdrop image
        if Palette.backdrop-opacity > 0: Image {
            source: Palette.backdrop;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
            opacity: Palette.backdrop-opacity;
        }

        VerticalLayout {
            if !Shell.native-frame: TitleBar { }
            HorizontalLayout {
                vertical-stretch: 1;
                NavRail { }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Breadcrumb {
                        current: root.page-title;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        library := LibraryPage {
                            visible: Shell.page == Page.library;
                        }
                        if Shell.page == Page.creator: Placeholder {
                            title: "Theme Creator";
                            note: "Coming next in the v3 build.";
                        }
                        if Shell.page == Page.community: Placeholder {
                            title: "Community Browser";
                            note: Shell.online-available ? "Coming next in the v3 build." : Shell.online-unavailable-reason;
                        }
                        if Shell.page == Page.settings: Placeholder {
                            title: "Settings";
                            note: "Coming next in the v3 build.";
                        }
                    }
                }
            }
        }

        // Toast
        if Shell.toast != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 28px;
            width: min(toast-text.preferred-width + 48px, parent.width - 80px);
            height: max(48px, toast-text.preferred-height + 24px);
            border-radius: 12px;
            background: Palette.surface1;
            border-width: 1px;
            border-color: Shell.toast-error ? Palette.danger.transparentize(40%) : Palette.accent.transparentize(50%);
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000aa;
            drop-shadow-offset-y: 8px;
            toast-text := Text {
                width: parent.width - 48px;
                text: Shell.toast;
                color: Shell.toast-error ? Palette.danger : Palette.text-hi;
                font-size: Type.body-md;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            TouchArea {
                clicked => { Shell.toast = ""; }
            }
        }

        // Edge resize handles (frameless windows only)
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "w"; x: 0; width: 5px; mouse-cursor: ew-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "e"; x: parent.width - 5px; width: 5px; mouse-cursor: ew-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "s"; y: parent.height - 5px; height: 5px; mouse-cursor: ns-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "n"; y: 0; height: 4px; mouse-cursor: ns-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "se"; x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px; mouse-cursor: nwse-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "sw"; x: 0; y: parent.height - 10px; width: 10px; height: 10px; mouse-cursor: nesw-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "ne"; x: parent.width - 10px; y: 0; width: 10px; height: 10px; mouse-cursor: nesw-resize; }
        if !Shell.native-frame && !Shell.maximized: ResizeEdge { edge: "nw"; x: 0; y: 0; width: 10px; height: 10px; mouse-cursor: nwse-resize; }
    }
}
