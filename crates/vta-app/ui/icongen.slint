// AI Icon Generator (design/v3-ui/ai_theme_icon_generator; v2 IconGeneratorDialog).
// Views: 0 = settings, 1 = results (icons at their real size), 2 = progress.

import { ScrollView, Slider } from "std-widgets.slint";
import { Palette, Type, Density } from "palette.slint";
import { Icons } from "icons.slint";
import { Icon, Btn, ButtonKind, IconBtn, KeyChip, Panel, Caption, Dropdown, Field, CheckRow, FormRow, StatusPill } from "widgets.slint";

export struct GenIcon {
    name: string,
    label: string,
    tip: string,
    image: image,
    has: bool,
}

export struct ReqRow {
    what: string,
    needed: string,
    have: string,
    state: int,   // 0 ok, 1 warn, 2 fail
}

export global IconGen {
    in property <string> status;
    in property <string> gpu-line;
    in property <bool> installed: false;
    in property <bool> needs-update: false;
    in property <bool> busy: false;
    in-out property <int> view: 0;
    // Options
    in property <[string]> generator-options: ["This PC (local AI)", "Google Gemini (your API key)"];
    in-out property <int> generator: 0;
    in property <[string]> model-options;
    in-out property <int> model: 0;
    in-out property <float> creativity: 75;
    in-out property <float> style: 55;
    in-out property <float> consistency: 70;
    in-out property <float> clarity: 50;
    in property <[string]> color-modes: ["Auto: use when they match the wallpapers", "Always use them", "Don't use them (wallpaper colours only)"];
    in-out property <int> color-mode: 0;
    in property <bool> color-mode-enabled: true;
    in property <[string]> layouts: ["Mixed variety", "Like example icon sets", "Character beside symbol", "Character portrait behind symbol", "Symbol only"];
    in-out property <int> layout-style: 0;
    in property <string> extra-label: "None (optional)";
    in property <bool> can-search-web: false;
    in-out property <bool> poses: false;
    in-out property <bool> redraw: true;
    in-out property <string> steps: "20";
    in-out property <string> seed: "0";
    in-out property <bool> lock-seed: false;
    in property <string> wallpapers-text;
    in property <string> examples-text;
    // Buttons
    in property <bool> can-generate: false;
    in property <bool> show-install: false;
    in property <string> install-text: "Install AI Components...";
    in property <bool> show-remove: false;
    in property <string> remove-text: "Remove AI Components";
    in property <bool> can-apply: false;
    // Results + progress
    in property <[GenIcon]> icons;
    in property <string> prog-title;
    in property <string> prog-phase;
    in property <float> prog-value: -1;
    in property <string> prog-count;
    in property <string> prog-eta;
    in property <image> prog-last;
    in property <bool> prog-has-last: false;
    in property <string> prog-last-name;
    // Log
    in-out property <bool> show-log: false;
    in property <string> log;
    // Requirements confirmation (v2 RequirementsDialog)
    in-out property <bool> req-open: false;
    in property <string> req-title;
    in property <string> req-intro;
    in property <string> req-estimate;
    in property <[ReqRow]> req-rows;
    in property <string> req-note;
    in property <bool> req-blocked: false;
    in property <string> req-saved-in;

    callback options-changed();
    callback generator-changed(int);
    callback install();
    callback remove();
    callback add-images();
    callback search-web();
    callback clear-images();
    callback reseed();
    callback generate();
    callback cancel();
    callback close();
    callback apply();
    callback req-answer(bool);
}

component Block inherits Panel {
    in property <string> caption;
    in property <string> note;
    VerticalLayout {
        padding: Density.compact ? 16px : 22px;
        spacing: 12px;
        HorizontalLayout {
            Caption {
                text: root.caption;
                horizontal-stretch: 1;
            }
            Text {
                text: root.note;
                color: Palette.success-text;
                font-size: Type.body-sm;
            }
        }
        @children
    }
}

component TuneSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> tip;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <bool> enabled: true;
    spacing: 4px;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Palette.text-hi;
            font-size: Type.body-md;
            font-weight: 500;
            horizontal-stretch: 1;
        }
        Text {
            text: round(root.value) / 100;
            color: Palette.accent;
            font-family: Palette.mono-font;
            font-size: Type.label-md;
        }
    }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        enabled: root.enabled;
        value <=> root.value;
        changed(v) => { IconGen.options-changed(); }
    }
}

component SettingsView inherits ScrollView {
    property <bool> cloud: IconGen.generator == 1;
    content-width: self.visible-width;
    VerticalLayout {
        padding-right: 12px;
        spacing: 16px;
        Block {
            caption: "ENGINE ARCHITECTURE";
            note: cloud ? "Cloud (Google Gemini)" : "Local Offline Engine";
            HorizontalLayout {
                spacing: 14px;
                FormRow {
                    label: "Generate with:";
                    horizontal-stretch: 1;
                    Dropdown {
                        max-width: 2000px;
                        options: IconGen.generator-options;
                        current-index <=> IconGen.generator;
                        selected(i) => { IconGen.generator-changed(i); }
                    }
                }
                FormRow {
                    label: "Model:";
                    horizontal-stretch: 1;
                    opacity: cloud ? 0.45 : 1;
                    Dropdown {
                        max-width: 2000px;
                        options: IconGen.model-options;
                        current-index <=> IconGen.model;
                        selected(i) => { IconGen.options-changed(); }
                    }
                }
            }
            Caption { text: "FINE-TUNING SLIDERS"; }
            TuneSlider { label: "Creativity"; minimum: 50; maximum: 100; value <=> IconGen.creativity; enabled: !cloud; }
            TuneSlider { label: "Theme style influence"; value <=> IconGen.style; enabled: !cloud; }
            TuneSlider { label: "Colour consistency"; value <=> IconGen.consistency; enabled: !cloud; }
            TuneSlider { label: "Symbol clarity"; value <=> IconGen.clarity; enabled: !cloud; }
        }
        Block {
            caption: "STYLING & CONDITIONING";
            note: "SCE Vita 128x128";
            HorizontalLayout {
                spacing: 14px;
                FormRow {
                    label: "Theme colours:";
                    horizontal-stretch: 1;
                    opacity: IconGen.color-mode-enabled ? 1 : 0.45;
                    Dropdown {
                        max-width: 2000px;
                        options: IconGen.color-modes;
                        current-index <=> IconGen.color-mode;
                    }
                }
                FormRow {
                    label: "Layout style:";
                    horizontal-stretch: 1;
                    Dropdown {
                        max-width: 2000px;
                        options: IconGen.layouts;
                        current-index <=> IconGen.layout-style;
                        selected(i) => { IconGen.options-changed(); }
                    }
                }
            }
            FormRow {
                label: "Extra artwork:";
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 42px;
                        border-radius: Palette.radius-control;
                        background: Palette.inset;
                        Text {
                            x: 14px;
                            text: IconGen.extra-label;
                            color: Palette.text-hi;
                            font-size: Type.body-md;
                        }
                    }
                    Btn { text: "Add Images..."; clicked => { IconGen.add-images(); } }
                    Btn { text: "Search Web..."; enabled: IconGen.can-search-web; clicked => { IconGen.search-web(); } }
                    Btn { text: "Clear"; kind: ButtonKind.ghost; clicked => { IconGen.clear-images(); } }
                }
            }
            HorizontalLayout {
                spacing: 20px;
                CheckRow {
                    horizontal-stretch: 1;
                    opacity: cloud ? 0.45 : 1;
                    checked <=> IconGen.poses;
                    text: "AI pose & expression variation (experimental)";
                }
                CheckRow {
                    horizontal-stretch: 1;
                    opacity: cloud ? 0.45 : 1;
                    checked <=> IconGen.redraw;
                    text: "Redraw characters into each icon (accuracy-checked)";
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: "Quality steps:"; color: Palette.text-mid; vertical-alignment: center; }
                Field {
                    width: 90px;
                    mono: true;
                    text <=> IconGen.steps;
                    suffix: "steps";
                    edited => { IconGen.options-changed(); }
                }
                Rectangle { width: 10px; }
                Text { text: "Seed:"; color: Palette.text-mid; vertical-alignment: center; }
                Field {
                    width: 150px;
                    mono: true;
                    text <=> IconGen.seed;
                }
                IconBtn {
                    icon: Icons.refresh;
                    y: (parent.height - self.height) / 2;
                    clicked => { IconGen.reseed(); }
                }
                CheckRow {
                    checked <=> IconGen.lock-seed;
                    text: "Lock seed";
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: "Style references: " + IconGen.wallpapers-text + "\nIcon examples: " + IconGen.examples-text;
                color: Palette.text-mid;
                font-size: Type.body-sm;
                wrap: word-wrap;
            }
        }
    }
}

component IconsGrid inherits Rectangle {
    // A Vita-screen style frame holding the 17 icons at their real 128 px size.
    border-radius: 18px;
    background: @linear-gradient(160deg, #0f2236 0%, #0a1018 100%);
    border-width: 1px;
    border-color: Palette.outline;
    property <int> cols: max(1, floor((self.width - 40px) / 150px));
    height: ceil(IconGen.icons.length / self.cols) * 166px + 40px;
    for icon[i] in IconGen.icons: Rectangle {
        x: 20px + mod(i, root.cols) * (root.width - 40px) / root.cols + ((root.width - 40px) / root.cols - 128px) / 2;
        y: 20px + floor(i / root.cols) * 166px;
        width: 128px;
        height: 160px;
        Rectangle {
            y: 0;
            width: 128px;
            height: 128px;
            border-radius: 64px;
            background: Palette.inset;
            clip: true;
            if icon.has: Image {
                source: icon.image;
                width: 128px;
                height: 128px;
            }
            if !icon.has: Text {
                text: "…";
                color: Palette.text-lo;
                font-size: 24px;
            }
        }
        Text {
            y: 132px;
            width: 128px;
            text: icon.label;
            color: Palette.text-hi;
            font-size: Type.body-sm;
            horizontal-alignment: center;
        }
    }
}

component ProgressView inherits VerticalLayout {
    alignment: center;
    spacing: 14px;
    padding: 30px;
    Text {
        text: IconGen.prog-title;
        color: Palette.text-hi;
        font-size: Type.headline-lg;
        font-weight: 700;
        horizontal-alignment: center;
    }
    Text {
        text: IconGen.prog-phase;
        color: Palette.text-mid;
        font-size: Type.body-md;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: min(560px, root.width - 60px);
            height: 10px;
            border-radius: 5px;
            background: Palette.surface3;
            clip: true;
            property <float> sweep: mod(animation-tick() / 1300ms, 1);
            if IconGen.prog-value >= 0: Rectangle {
                x: 0;
                width: parent.width * clamp(IconGen.prog-value, 0, 1);
                border-radius: 5px;
                background: @linear-gradient(90deg, Palette.primary 0%, Palette.accent 100%);
                animate width { duration: 250ms; }
            }
            if IconGen.prog-value < 0: Rectangle {
                width: parent.width * 0.3;
                x: parent.width * 1.3 * parent.sweep - self.width;
                border-radius: 5px;
                background: @linear-gradient(90deg, transparent 0%, Palette.accent 50%, transparent 100%);
            }
        }
    }
    Text {
        text: IconGen.prog-count;
        color: Palette.text-hi;
        font-size: Type.body-lg;
        horizontal-alignment: center;
    }
    Text {
        text: IconGen.prog-eta;
        color: Palette.accent;
        font-size: Type.body-lg;
        font-weight: 700;
        horizontal-alignment: center;
    }
    if IconGen.prog-has-last: HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 128px;
            height: 128px;
            border-radius: 64px;
            clip: true;
            background: Palette.inset;
            Image {
                source: IconGen.prog-last;
                width: 128px;
                height: 128px;
            }
        }
    }
    Text {
        text: IconGen.prog-last-name;
        color: Palette.text-mid;
        font-size: Type.body-sm;
        horizontal-alignment: center;
    }
}

component ReqLayer inherits Rectangle {
    if IconGen.req-open: Rectangle {
        background: #000000a8;
        TouchArea { }
        Rectangle {
            width: min(620px, root.width - 48px);
            height: body.preferred-height;
            border-radius: Palette.radius-card;
            background: Palette.surface1;
            border-width: 1px;
            border-color: #ffffff14;
            drop-shadow-blur: 40px;
            drop-shadow-color: #000000a0;
            body := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: IconGen.req-title; color: Palette.text-hi; font-size: Type.headline-md; font-weight: 600; }
                Text { text: IconGen.req-intro; color: Palette.text-hi; font-weight: 600; wrap: word-wrap; }
                Text { text: IconGen.req-estimate; color: Palette.text-mid; font-size: Type.body-sm; wrap: word-wrap; }
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: ""; }
                        Text { text: "Requirement"; color: Palette.text-hi; font-weight: 700; font-size: Type.body-sm; }
                        Text { text: "Needed"; color: Palette.text-hi; font-weight: 700; font-size: Type.body-sm; }
                        Text { text: "This PC"; color: Palette.text-hi; font-weight: 700; font-size: Type.body-sm; }
                    }
                    for r in IconGen.req-rows: Row {
                        Text {
                            text: r.state == 0 ? "✔" : r.state == 1 ? "⚠" : "✖";
                            color: r.state == 0 ? #2e9e44 : r.state == 1 ? #d08a00 : #d23c3c;
                            font-size: 15px;
                        }
                        Text { text: r.what; color: Palette.text-hi; font-size: Type.body-sm; wrap: word-wrap; }
                        Text { text: r.needed; color: Palette.text-mid; font-size: Type.body-sm; wrap: word-wrap; }
                        Text { text: r.have; color: Palette.text-mid; font-size: Type.body-sm; wrap: word-wrap; }
                    }
                }
                Text { text: IconGen.req-note; color: IconGen.req-blocked ? Palette.danger : Palette.text-hi; font-weight: IconGen.req-blocked ? 700 : 400; wrap: word-wrap; }
                Text { text: "Saved in: " + IconGen.req-saved-in; color: Palette.text-lo; font-size: Type.body-sm; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Btn {
                        text: "Start Download";
                        kind: ButtonKind.success;
                        enabled: !IconGen.req-blocked;
                        clicked => { IconGen.req-answer(true); }
                    }
                    Btn {
                        text: "Don't Download";
                        clicked => { IconGen.req-answer(false); }
                    }
                }
            }
        }
    }
}

export component IconGenPage inherits Rectangle {
    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 14px;
        spacing: 12px;
        // Header
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "AI Theme Icon Generator";
                    color: Palette.text-hi;
                    font-size: Type.headline-xl;
                    font-weight: 700;
                }
                Text {
                    text: "Generates the 17 system icons from the template icons, styled by this theme's wallpapers.";
                    color: Palette.text-mid;
                    font-size: Type.body-sm;
                }
            }
            if IconGen.gpu-line != "": VerticalLayout {
                alignment: center;
                StatusPill {
                    text: IconGen.gpu-line;
                    dot: Palette.success;
                    fg: Palette.text-hi;
                }
            }
        }
        // Status line (v2's status label)
        if IconGen.view != 2 && IconGen.status != "": Rectangle {
            border-radius: 12px;
            background: IconGen.needs-update ? Palette.primary.transparentize(85%) : Palette.surface1;
            border-width: 1px;
            border-color: IconGen.needs-update ? Palette.accent.transparentize(50%) : Palette.outline.transparentize(40%);
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                Icon {
                    source: Icons.info;
                    size: 20px;
                    tint: Palette.accent;
                }
                Text {
                    text: IconGen.status;
                    color: Palette.text-hi;
                    font-size: Type.body-md;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if IconGen.view == 0: SettingsView { }
            if IconGen.view == 1: ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding-right: 12px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        Icon { source: Icons.apps; size: 22px; tint: Palette.accent; }
                        Text { text: "LiveArea Bubble Preview Matrix"; color: Palette.text-hi; font-size: Type.headline-md; font-weight: 600; vertical-alignment: center; }
                        KeyChip { text: IconGen.icons.length + " Targets"; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    IconsGrid { }
                }
            }
            if IconGen.view == 2: ProgressView { }
        }
        if IconGen.show-log: Rectangle {
            height: 140px;
            border-radius: 10px;
            background: Palette.inset;
            ScrollView {
                content-width: self.visible-width;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: IconGen.log;
                    color: Palette.text-mid;
                    font-family: Palette.mono-font;
                    font-size: Type.label-md;
                    wrap: word-wrap;
                }
            }
        }
        // Footer (v2 button row)
        Panel {
            height: 64px;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                Btn {
                    text: IconGen.show-log ? "Hide Log" : "Show Log";
                    icon: Icons.description;
                    has-icon: true;
                    kind: ButtonKind.ghost;
                    clicked => { IconGen.show-log = !IconGen.show-log; }
                }
                if IconGen.view == 1 && !IconGen.busy: Btn {
                    text: "Change Settings";
                    kind: ButtonKind.ghost;
                    clicked => { IconGen.view = 0; }
                }
                if IconGen.show-install && !IconGen.busy: Btn {
                    text: IconGen.install-text;
                    icon: Icons.download;
                    has-icon: true;
                    clicked => { IconGen.install(); }
                }
                if IconGen.show-remove && !IconGen.busy: Btn {
                    text: IconGen.remove-text;
                    kind: ButtonKind.danger;
                    clicked => { IconGen.remove(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if IconGen.busy: Btn {
                    text: "Cancel";
                    clicked => { IconGen.cancel(); }
                }
                Btn {
                    text: "Close";
                    kind: ButtonKind.ghost;
                    clicked => { IconGen.close(); }
                }
                if !IconGen.busy: Btn {
                    text: "Use Generated Icons";
                    enabled: IconGen.can-apply;
                    clicked => { IconGen.apply(); }
                }
                if !IconGen.busy: Btn {
                    text: "Generate";
                    icon: Icons.auto-awesome;
                    has-icon: true;
                    hotkey: "F5";
                    kind: ButtonKind.primary;
                    enabled: IconGen.can-generate;
                    clicked => { IconGen.generate(); }
                }
            }
        }
    }
    ReqLayer {
        width: parent.width;
        height: parent.height;
    }
}
