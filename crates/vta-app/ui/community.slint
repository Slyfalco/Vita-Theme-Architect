// Community Browser (design/v3-ui/community_theme_repository).

import { ScrollView } from "std-widgets.slint";
import { Palette, Type, Density } from "palette.slint";
import { Icons } from "icons.slint";
import { Icon, Btn, ButtonKind, IconBtn, Tag, Segment, Panel, Caption, SearchField, Dropdown, Field } from "widgets.slint";
import { Shell } from "state.slint";

export struct RemoteTheme {
    index: int,
    title: string,
    author: string,
    version: string,
    downloads: string,
    preview: image,
    has-preview: bool,
    // Repository rating (worked out by the online module):
    verified: bool,       // clean validation → "Verified" badge
    stars: float,         // 0.0–5.0
    rating: string,       // the stars as text, e.g. "4.9"
}

export struct PageButton {
    number: int,     // 0 = ellipsis
}

export global Community {
    in property <bool> available: false;
    in property <string> unavailable-reason;
    in property <bool> loading: false;
    in property <string> error;
    in property <[RemoteTheme]> themes;
    in property <int> list-version: 0;   // bumped on each new page: scroll to top
    in property <string> total-text;
    in property <int> page: 1;
    in property <int> pages: 1;
    in property <[PageButton]> pager;
    in-out property <string> search;
    in-out property <int> field: 0;    // title, author, tags
    in-out property <int> sort: 0;     // newest, oldest, az, za, downloads
    in-out property <int> filter: 0;   // all, verified, top rated, staff picks
    in-out property <int> page-size: 2; // index into [12, 24, 50]
    in-out property <string> goto-page: "1";
    in-out property <int> selected: -1;
    // Detail
    in property <string> d-title;
    in property <string> d-author;
    in property <string> d-version;
    in property <string> d-downloads;
    in property <string> d-added;
    in property <string> d-updated;
    in property <string> d-validation;
    in property <bool> d-vita-validated;
    in property <bool> d-verified;
    in property <string> d-rating;       // e.g. "4.9"
    in property <float> d-stars;
    in property <string> d-votes;        // e.g. "101 checks"
    in property <string> d-description;
    in property <[string]> d-tags;
    in property <bool> d-has-extra;
    in property <image> d-home;
    in property <image> d-lock;
    in property <bool> d-home-loaded;
    in property <bool> d-lock-loaded;
    in-out property <int> d-tab: 0;

    callback search-changed(string);
    callback field-changed(int);
    callback sort-changed(int);
    callback filter-changed(int);
    callback page-size-changed(int);
    callback show-page(int);
    callback reload();
    callback select(int);
    callback tag-clicked(string);
    in-out property <bool> auto-deploy: false;
    callback download();
    callback quick-install(int);
    callback download-extra();
}

component ThemeTile inherits Rectangle {
    in property <RemoteTheme> theme;
    in property <bool> selected;
    // Everything inside scales with the card width so nothing clips as cards
    // resize: `s` is the card width relative to a ~280px reference, clamped.
    property <float> s: max(0.62, min(1.35, root.width / 280px));
    property <length> pad: 12px * self.s;
    property <length> pill-h: 22px * self.s;
    property <length> pill-fs: max(8px, 11px * self.s);
    property <bool> tiny: root.width < 190px;
    border-radius: Palette.radius-card;
    background: root.selected ? Palette.surface3 : touch.has-hover ? Palette.surface2.brighter(5%) : Palette.surface2;
    border-width: 1px;
    border-color: root.selected ? Palette.accent.transparentize(30%) : touch.has-hover ? Palette.accent.transparentize(55%) : Palette.outline.transparentize(40%);
    drop-shadow-blur: root.selected ? 22px : 0;
    drop-shadow-color: Palette.primary.transparentize(70%);
    animate background, border-color { duration: 150ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        // Clicking the selected card again closes the detail panel.
        clicked => { Community.select(root.selected ? -1 : root.theme.index); }
        double-clicked => {
            Community.select(root.theme.index);
            Community.download();
        }
    }
    VerticalLayout {
        padding: root.pad;
        spacing: 7px * root.s;
        Rectangle {
            height: self.width * 9 / 16;   // keep the 16:9 preview aspect
            border-radius: 10px * root.s;
            background: Palette.inset;
            clip: true;
            if root.theme.has-preview: Image {
                source: root.theme.preview;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.theme.has-preview: Icon {
                source: Icons.image;
                size: 30px * root.s;
                tint: Palette.text-lo;
            }
            // Repository badge (top-left): Verified (clean validation) or Community.
            Rectangle {
                x: 6px * root.s;
                y: 6px * root.s;
                width: badge-row.preferred-width + 14px * root.s;
                height: root.pill-h;
                border-radius: self.height / 2;
                background: root.theme.verified ? #0f2b1dbf : #1e293bbf;
                border-width: 1px;
                border-color: root.theme.verified ? Palette.success.transparentize(50%) : #ffffff1f;
                badge-row := HorizontalLayout {
                    x: 7px * root.s;
                    spacing: 3px * root.s;
                    alignment: center;
                    if root.theme.verified && !root.tiny: Icon {
                        source: Icons.check-circle;
                        size: root.pill-fs + 2px;
                        tint: Palette.success-text;
                    }
                    Text {
                        text: root.theme.verified ? "Verified" : "Community";
                        color: root.theme.verified ? Palette.success-text : Palette.text-mid;
                        font-size: root.pill-fs;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
            // Star rating (bottom-right).
            if root.theme.stars > 0: Rectangle {
                x: parent.width - self.width - 6px * root.s;
                y: parent.height - self.height - 6px * root.s;
                width: star-row.preferred-width + 14px * root.s;
                height: root.pill-h;
                border-radius: self.height / 2;
                background: #0b1220cc;
                star-row := HorizontalLayout {
                    x: 7px * root.s;
                    spacing: 3px * root.s;
                    alignment: center;
                    Text { text: "★"; color: Palette.success-text; font-size: root.pill-fs; vertical-alignment: center; }
                    Text {
                        text: root.theme.rating;
                        color: Palette.text-hi;
                        font-size: root.pill-fs;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Text {
            text: root.theme.title;
            color: Palette.text-hi;
            font-size: max(11px, 15px * root.s);
            font-weight: 600;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 5px * root.s;
            Text {
                text: "by";
                color: Palette.text-mid;
                font-size: max(9px, 12px * root.s);
                vertical-alignment: center;
            }
            Text {
                text: root.theme.author;
                color: Palette.text-hi;
                font-size: max(9px, 12px * root.s);
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if !root.tiny: Text {
                text: "v" + root.theme.version;
                color: Palette.text-lo;
                font-family: Palette.mono-font;
                font-size: max(8px, 10px * root.s);
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 5px * root.s;
            Icon {
                source: Icons.download;
                size: max(11px, 14px * root.s);
                tint: Palette.text-lo;
            }
            Text {
                text: root.theme.downloads;
                color: Palette.text-mid;
                font-size: max(9px, 12px * root.s);
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                text: root.tiny ? "" : Community.auto-deploy ? "Quick Deploy" : "Quick Install";
                icon: Icons.download;
                has-icon: true;
                compact: true;
                font-size: max(10px, 12px * root.s);
                enabled: !Community.loading;
                clicked => { Community.quick-install(root.theme.index); }
            }
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <float> k: 1.0;   // panel fit factor
    border-radius: 10px * root.k;
    background: Palette.inset;
    VerticalLayout {
        padding: 10px * root.k;
        spacing: 3px * root.k;
        Text {
            text: root.label;
            color: Palette.text-mid;
            font-size: Type.body-sm * root.k;
            overflow: elide;
        }
        Text {
            text: root.value;
            color: Palette.text-hi;
            font-size: Type.body-lg * root.k;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: Palette.text-lo;
            font-size: Type.label-sm * root.k;
        }
    }
}

component Inspector inherits Panel {
    // Fit factor: everything in the panel scales by `k` so the detail fits the
    // panel height without scrolling. `natural` approximates the content height
    // at k = 1 (constant inputs only — no layout loop); scrolling stays as the
    // fallback for unusually long descriptions.
    property <length> natural: 760px
        + (Community.d-description != "" ? 100px : 0px)
        + (Community.d-has-extra ? 50px : 0px)
        + (Community.d-tags.length > 0 ? 70px : 0px);
    property <float> k: max(0.5, min(1.0, root.height / root.natural));
    width: Density.narrow ? 360px : 440px;
    if Community.selected < 0: VerticalLayout {
        alignment: center;
        padding: 32px;
        spacing: 12px;
        Icon {
            source: Icons.visibility;
            size: 40px;
            tint: Palette.text-lo;
        }
        Text {
            text: "Select a theme to see its details";
            color: Palette.text-mid;
            horizontal-alignment: center;
        }
    }
    if Community.selected >= 0: ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            padding: 18px * root.k;
            spacing: 12px * root.k;
            HorizontalLayout {
                spacing: 8px * root.k;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 10px * root.k;
                    height: 10px * root.k;
                    border-radius: self.width / 2;
                    background: Palette.accent;
                }
                Text {
                    text: "Theme Preview";
                    color: Palette.text-hi;
                    font-size: Type.body-md * root.k;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                // Close the detail panel (deselect; it slides away).
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        scale: root.k;
                        icon: Icons.close;
                        tooltip: "Close";
                        clicked => { Community.select(-1); }
                    }
                }
            }
            HorizontalLayout {
                Rectangle {
                    height: 34px * root.k;
                    horizontal-stretch: 1;
                    border-radius: 8px * root.k;
                    background: Palette.inset;
                    HorizontalLayout {
                        padding: 3px * root.k;
                        spacing: 2px * root.k;
                        Segment { scale: root.k; text: "LiveArea"; horizontal-stretch: 1; selected: Community.d-tab == 0; clicked => { Community.d-tab = 0; } }
                        Segment { scale: root.k; text: "Lockscreen"; horizontal-stretch: 1; selected: Community.d-tab == 1; clicked => { Community.d-tab = 1; } }
                    }
                }
            }
            // Preview at 16:9, panel width scaled by the fit factor (centred).
            stage-box := Rectangle {
                height: self.width * 9 / 16 * root.k;
            stage := Rectangle {
                x: (parent.width - self.width) / 2;
                width: parent.height * 16 / 9;
                height: parent.height;
                border-radius: 12px * root.k;
                background: #05070a;
                border-width: 1px;
                border-color: Palette.outline;
                clip: true;
                property <bool> loaded: Community.d-tab == 0 ? Community.d-home-loaded : Community.d-lock-loaded;
                if stage.loaded: Image {
                    source: Community.d-tab == 0 ? Community.d-home : Community.d-lock;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
                if !stage.loaded: Text {
                    text: "Loading preview…";
                    color: Palette.text-mid;
                    font-size: Type.body-sm * root.k;
                }
            }
            }
            HorizontalLayout {
                spacing: 8px * root.k;
                Text {
                    text: Community.d-title;
                    color: Palette.text-hi;
                    font-size: (Type.headline-lg + 4px) * root.k;
                    font-weight: 700;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                // "Vita Validated" (no errors) or "Community" (has errors / unchecked).
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        height: 24px * root.k;
                        width: val-row.preferred-width + 18px * root.k;
                        border-radius: self.height / 2;
                        background: Community.d-vita-validated ? #0f2b1dbf : #1e293bbf;
                        border-width: 1px;
                        border-color: Community.d-vita-validated ? Palette.success.transparentize(50%) : #ffffff1f;
                        val-row := HorizontalLayout {
                            x: 9px * root.k;
                            spacing: 4px * root.k;
                            alignment: center;
                            if Community.d-vita-validated: Icon { source: Icons.check-circle; size: 13px * root.k; tint: Palette.success-text; }
                            Text {
                                text: Community.d-vita-validated ? "Vita Validated" : "Community";
                                color: Community.d-vita-validated ? Palette.success-text : Palette.text-mid;
                                font-size: Type.label-md * root.k;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 5px * root.k;
                Text { text: "Created by"; color: Palette.text-mid; font-size: Type.body-md * root.k; }
                Text { text: Community.d-author; color: Palette.accent; font-size: Type.body-md * root.k; font-weight: 600; overflow: elide; }
                Text { text: "•  v" + Community.d-version; color: Palette.text-lo; font-size: Type.body-md * root.k; }
                Rectangle { horizontal-stretch: 1; }
            }
            GridLayout {
                spacing: 7px * root.k;
                Row {
                    StatTile { k: root.k; label: "Total Downloads"; value: Community.d-downloads; }
                    StatTile {
                        k: root.k;
                        label: "Community Rating";
                        value: Community.d-stars > 0 ? "★ " + Community.d-rating : "Not rated";
                        sub: Community.d-stars > 0 ? Community.d-votes : "";
                    }
                }
                Row {
                    StatTile { k: root.k; label: "Date Added"; value: Community.d-added; }
                    StatTile { k: root.k; label: "Last Updated"; value: Community.d-updated; }
                }
            }
            Text {
                text: "Validation: " + Community.d-validation;
                color: Palette.text-lo;
                font-size: Type.label-md * root.k;
            }
            if Community.d-description != "": VerticalLayout {
                spacing: 4px * root.k;
                Text { text: "DESCRIPTION"; color: Palette.text-lo; font-size: Type.label-sm * root.k; font-weight: 600; letter-spacing: 1px; }
                Text {
                    text: Community.d-description;
                    color: Palette.text-hi;
                    font-size: Type.body-md * root.k;
                    wrap: word-wrap;
                }
            }
            if Community.d-tags.length > 0: VerticalLayout {
                spacing: 6px * root.k;
                Text { text: "TAGS"; color: Palette.text-lo; font-size: Type.label-sm * root.k; font-weight: 600; letter-spacing: 1px; }
                // Wrapping row of tag chips (approximate flow layout).
                tags := Rectangle {
                    property <length> chip-w: 120px * root.k;
                    property <length> row-h: 36px * root.k;
                    property <int> per-row: max(1, floor(self.width / (self.chip-w + 8px * root.k)));
                    height: ceil(Community.d-tags.length / self.per-row) * self.row-h;
                    for t[i] in Community.d-tags: Rectangle {
                        x: mod(i, tags.per-row) * (tags.chip-w + 8px * root.k);
                        y: floor(i / tags.per-row) * tags.row-h;
                        width: tags.chip-w;
                        height: 28px * root.k;
                        border-radius: 6px * root.k;
                        background: tag-touch.has-hover ? Palette.surface3 : Palette.inset;
                        Text {
                            text: t;
                            width: parent.width - 12px * root.k;
                            color: Palette.text-hi;
                            font-size: Type.body-sm * root.k;
                            overflow: elide;
                            horizontal-alignment: center;
                        }
                        tag-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Community.tag-clicked(t); }
                        }
                    }
                }
            }
            if Community.d-has-extra: Btn {
                scale: root.k;
                text: "Open / Download Extra";
                icon: Icons.stacks;
                has-icon: true;
                clicked => { Community.download-extra(); }
            }
            // Auto-deploy: after import, send straight to the connected Vita.
            Rectangle {
                height: deploy-row.preferred-height;
                border-radius: 10px * root.k;
                background: Palette.inset;
                deploy-row := HorizontalLayout {
                    padding: 11px * root.k;
                    spacing: 9px * root.k;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 20px * root.k;
                            height: 20px * root.k;
                            border-radius: 5px * root.k;
                            background: Community.auto-deploy ? Palette.accent : transparent;
                            border-width: 1px;
                            border-color: Community.auto-deploy ? Palette.accent : Palette.outline;
                            if Community.auto-deploy: Icon { source: Icons.check-circle; size: 15px * root.k; tint: #ffffff; }
                            TouchArea { clicked => { Community.auto-deploy = !Community.auto-deploy; } }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px * root.k;
                        horizontal-stretch: 1;
                        Text { text: "Auto-deploy to PS Vita"; color: Palette.text-hi; font-size: Type.body-md * root.k; font-weight: 600; }
                        Text {
                            text: "After import, send over the active FTP connection.";
                            color: Palette.text-mid;
                            font-size: Type.label-md * root.k;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            Btn {
                scale: root.k;
                text: Community.auto-deploy ? "Download, Import & Deploy" : "Download & Import Theme";
                icon: Icons.cloud-upload;
                has-icon: true;
                kind: ButtonKind.primary;
                min-height: 52px * root.k;
                font-size: Type.body-lg;
                clicked => { Community.download(); }
            }
        }
    }
}

export component CommunityPage inherits Rectangle {
    if !Community.available: VerticalLayout {
        alignment: center;
        spacing: 14px;
        Icon {
            source: Icons.public;
            size: 56px;
            tint: Palette.text-lo;
        }
        Text {
            text: "Community Browser";
            color: Palette.text-hi;
            font-size: Type.headline-xl;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: Community.unavailable-reason;
            color: Palette.text-mid;
            font-size: Type.body-md;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if Community.available: VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: Density.compact ? 10px : 16px;
        spacing: Density.compact ? 8px : 14px;
        Panel {
            height: Density.compact ? 46px : 72px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    SearchField {
                        placeholder: "Search the community repository";
                        text <=> Community.search;
                        edited(t) => { Community.search-changed(t); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        min-width: 170px;
                        options: ["Search by Title", "Search by Author", "Search by Tags"];
                        current-index <=> Community.field;
                        selected(i) => { Community.field-changed(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        min-width: 210px;
                        options: ["Last Updated (Newest)", "Last Updated (Oldest)", "Alphabetical (A-Z)", "Alphabetical (Z-A)", "Most Downloaded"];
                        current-index <=> Community.sort;
                        selected(i) => { Community.sort-changed(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Dropdown {
                        min-width: 120px;
                        options: ["12 / page", "24 / page", "50 / page"];
                        current-index <=> Community.page-size;
                        selected(i) => { Community.page-size-changed(i); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        text: "Reload";
                        icon: Icons.refresh;
                        has-icon: true;
                        enabled: !Community.loading;
                        clicked => { Community.reload(); }
                    }
                }
            }
        }
        // Category chips — data-driven (the catalog has no genre tags): All, plus
        // filters derived from each theme's repository validation.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for label[i] in ["All Themes", "Verified", "Top Rated", "Staff Picks"]: Segment {
                text: label;
                selected: Community.filter == i;
                clicked => {
                    if (Community.filter != i) {
                        Community.filter = i;
                        Community.filter-changed(i);
                    }
                }
            }
        }
        cbody := HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            // Catalog width once the inspector has finished sliding. The grid's
            // columns and card size come from this (not the animating width), so the
            // cards don't re-lay out or jump column count during the slide.
            property <length> grid-target: self.width - (Community.selected >= 0 ? cslot.full : 0px) - 14px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                HorizontalLayout {
                    Caption { text: "REPOSITORY CATALOG"; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: Community.loading ? "Loading…" : Community.total-text;
                        color: Palette.text-mid;
                        font-size: Type.body-sm;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    if Community.error != "": Text {
                        text: Community.error;
                        color: Palette.danger;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        width: parent.width - 40px;
                    }
                    // Responsive card grid: the column count follows the available
                    // width, cards (and their contents) resize to fit, and the whole
                    // grid scrolls so a full page of cards is never cut off.
                    scroller := ScrollView {
                        property <int> version: Community.list-version;
                        changed version => { self.content-y = 0; }
                        property <length> gap: 14px;
                        property <length> min-card: 240px;
                        property <int> cols: max(1, floor((cbody.grid-target + self.gap) / (self.min-card + self.gap)));
                        property <length> cell-w: (cbody.grid-target - (self.cols - 1) * self.gap) / self.cols;
                        property <length> cell-h: self.cell-w * 9 / 16 + self.cell-w * 0.44;
                        property <int> rows: max(1, ceil(Community.themes.length / self.cols));
                        content-width: self.visible-width;
                        content-height: self.rows * self.cell-h + (self.rows - 1) * self.gap;
                        for t[i] in Community.themes: ThemeTile {
                            theme: t;
                            selected: t.index == Community.selected;
                            x: mod(i, scroller.cols) * (scroller.cell-w + scroller.gap);
                            y: floor(i / scroller.cols) * (scroller.cell-h + scroller.gap);
                            width: scroller.cell-w;
                            height: scroller.cell-h;
                        }
                    }
                }
                // Pager
                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        text: "Previous";
                        compact: true;
                        enabled: Community.page > 1 && !Community.loading;
                        clicked => { Community.show-page(Community.page - 1); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    for p in Community.pager: Rectangle {
                        width: 38px;
                        height: 36px;
                        border-radius: 8px;
                        background: p.number == Community.page ? Palette.primary : p.number > 0 && pg-touch.has-hover ? Palette.surface3 : p.number > 0 ? Palette.surface2 : transparent;
                        Text {
                            text: p.number > 0 ? p.number : "…";
                            color: p.number == Community.page ? Palette.on-primary : Palette.text-hi;
                            font-size: Type.body-sm;
                        }
                        pg-touch := TouchArea {
                            enabled: p.number > 0 && p.number != Community.page;
                            mouse-cursor: pointer;
                            clicked => { Community.show-page(p.number); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Next";
                        compact: true;
                        enabled: Community.page < Community.pages && !Community.loading;
                        clicked => { Community.show-page(Community.page + 1); }
                    }
                    Rectangle { width: 16px; }
                    Text {
                        text: "Go to page:";
                        color: Palette.text-mid;
                        font-size: Type.body-sm;
                        vertical-alignment: center;
                    }
                    Field {
                        width: 70px;
                        mono: true;
                        text <=> Community.goto-page;
                    }
                    Btn {
                        text: "Jump";
                        compact: true;
                        clicked => { Community.show-page(Community.goto-page.to-float()); }
                    }
                }
            }
            // Detail panel slides in from the right only while a theme is selected;
            // the catalog shrinks to fit (and grows back when it closes).
            cslot := Rectangle {
                property <bool> open: Community.selected >= 0;
                property <length> panel-w: Density.narrow ? 360px : 440px;
                property <length> gap: 20px;
                property <length> full: self.panel-w + self.gap;
                width: self.open ? self.full : 0px;
                animate width { duration: 220ms; easing: ease-in-out; }
                clip: true;
                Inspector {
                    x: parent.width - self.width;
                    width: cslot.panel-w;
                    height: parent.height;
                }
            }
        }
    }
}
