// Theme Library (design/v3-ui/theme_library_manager).

import { ScrollView } from "std-widgets.slint";
import { Palette, Type, Density } from "palette.slint";
import { Icons } from "icons.slint";
import { Icon, Btn, ButtonKind, IconBtn, KeyChip, Tag, Segment, SearchField, Dropdown, Panel, Caption } from "widgets.slint";
import { Library, ThemeRow, Shell } from "state.slint";

// ---------------------------------------------------------------- toolbar rows

// One unified bar: search + filters + sort on the left, library folder and
// Import menus on the right. (Replaces the old two-row toolbar + filter row;
// every action and shortcut is kept — Import and the folder actions moved into
// menus, the theme count lives in the status bar.)
// A popup-menu row: icon + label left-aligned, shortcut chip pinned right.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> hotkey;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();
    property <color> fg: !root.enabled ? Palette.text-lo : root.danger ? Palette.danger : Palette.text-hi;
    height: 36px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? (root.danger ? Palette.danger.transparentize(88%) : Palette.surface3) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            source: root.icon;
            size: 18px;
            tint: root.fg;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Type.body-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.hotkey != "": VerticalLayout {
            alignment: center;
            KeyChip { text: root.hotkey; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component LibraryBar inherits Panel {
    callback focus-search();
    focus-search => { search.focus-input(); }
    height: Density.compact ? 48px : 62px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 160px;
            max-width: 440px;
            search := SearchField {
                placeholder: Density.narrow ? "Search themes"
                    : Library.search-field == 0 ? "Search themes by title" : "Search themes by author";
                hotkey: Density.narrow ? "" : "Ctrl+F";
                text <=> Library.search;
                edited(t) => { Library.search-changed(t); }
            }
        }
        VerticalLayout {
            alignment: center;
            Dropdown {
                min-width: 150px;
                options: ["Search by Title", "Search by Author"];
                current-index <=> Library.search-field;
                selected(i) => { Library.search-field-changed(i); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: Density.compact ? 32px : 40px;
                border-radius: 9px;
                background: Palette.inset;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    Segment {
                        min-width: 0px;
                        text: (Density.narrow ? "All " : "All (") + Library.total + (Density.narrow ? "" : ")");
                        selected: Library.filter == 0;
                        clicked => { Library.filter-changed(0); }
                    }
                    Segment {
                        min-width: 0px;
                        text: (Density.narrow ? "BGM " : "With BGM (") + Library.with-bgm + (Density.narrow ? "" : ")");
                        selected: Library.filter == 1;
                        clicked => { Library.filter-changed(1); }
                    }
                    Segment {
                        min-width: 0px;
                        text: (Density.narrow ? "Icons " : "Custom Icons (") + Library.with-icons + (Density.narrow ? "" : ")");
                        selected: Library.filter == 2;
                        clicked => { Library.filter-changed(2); }
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Dropdown {
                options: Library.sort-options;
                current-index <=> Library.sort;
                selected(i) => { Library.sort-changed(i); }
            }
        }
        // Library folder menu (open / copy the path; the path itself is shown).
        VerticalLayout {
            alignment: center;
            folder := IconBtn {
                icon: Icons.folder-open;
                tooltip: "Library folder";
                clicked => { folder-menu.show(); }
            }
        }
        // Import menu.
        VerticalLayout {
            alignment: center;
            import-btn := Btn {
                text: "Import";
                icon: Icons.download;
                has-icon: true;
                kind: ButtonKind.primary;
                clicked => { import-menu.show(); }
            }
        }
    }
    folder-menu := PopupWindow {
        x: root.width - 380px;
        y: root.height + 6px;
        width: 360px;
        Rectangle {
            background: Palette.surface1;
            border-radius: Palette.radius-control;
            border-width: 1px;
            border-color: #ffffff14;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    text: Shell.library-path;
                    color: Palette.text-mid;
                    font-family: Palette.mono-font;
                    font-size: Type.label-md;
                    overflow: elide;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    height: 30px;
                    x: 8px;
                    width: parent.width - 16px;
                }
                MenuItem {
                    text: "Open Library Folder";
                    icon: Icons.folder-open;
                    clicked => { Library.open-library-folder(); }
                }
                MenuItem {
                    text: "Copy Path";
                    icon: Icons.content-copy;
                    clicked => { Library.copy-path(); }
                }
            }
        }
    }
    import-menu := PopupWindow {
        x: root.width - 350px;
        y: root.height + 6px;
        width: 340px;
        Rectangle {
            background: Palette.surface1;
            border-radius: Palette.radius-control;
            border-width: 1px;
            border-color: #ffffff14;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuItem {
                    text: "Import .zip";
                    icon: Icons.folder-zip;
                    hotkey: "Ctrl+I";
                    clicked => { Library.import-zip(); }
                }
                MenuItem {
                    text: "Import Folder";
                    icon: Icons.drive-folder-upload;
                    hotkey: "Ctrl+O";
                    clicked => { Library.import-folder(); }
                }
                MenuItem {
                    text: "Import Multiple Themes";
                    icon: Icons.stacks;
                    hotkey: "Ctrl+Shift+I";
                    clicked => { Library.import-multiple(); }
                }
                MenuItem {
                    text: "Import from PS Vita";
                    icon: Icons.send-to-mobile;
                    hotkey: "Ctrl+V";
                    clicked => { Library.import-from-vita(); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- theme cards

component ThemeCard inherits Rectangle {
    in property <ThemeRow> theme;
    in property <int> index;
    in property <bool> selected;
    property <bool> hovered: touch.has-hover;
    // Width available to the row (from the list's visible width — reading our own
    // width would loop through the scroll area). Row height and everything inside
    // scale with it (`s` vs a ~760px reference), so rows stay compact and text
    // never crowds or clips.
    in property <length> avail: 760px;
    property <float> s: max(0.72, min(1.12, root.avail / 760px));
    height: max(96px, min(150px, root.avail * 0.15));
    border-radius: Palette.radius-card;
    background: root.selected ? Palette.surface3 : root.hovered ? Palette.surface2.brighter(6%) : Palette.surface2;
    border-width: 1px;
    border-color: root.selected ? Palette.accent.transparentize(30%) : root.hovered ? Palette.accent.transparentize(55%) : Palette.outline.transparentize(30%);
    drop-shadow-blur: root.selected ? 24px : root.hovered ? 16px : 0;
    drop-shadow-color: Palette.primary.transparentize(root.selected ? 70% : 80%);
    drop-shadow-offset-y: 6px;
    animate background, border-color, drop-shadow-blur { duration: 150ms; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        // Clicking the selected theme again closes the inspector.
        clicked => { Library.select(root.selected ? -1 : root.index); }
        double-clicked => { Library.edit(root.index); }
    }
    // Selection accent bar
    if root.selected: Rectangle {
        x: 0;
        y: 10px * root.s;
        width: 4px;
        height: parent.height - 20px * root.s;
        border-radius: 2px;
        background: Palette.accent;
        drop-shadow-blur: 8px;
        drop-shadow-color: Palette.accent;
    }
    HorizontalLayout {
        padding: 10px * root.s;
        padding-left: 14px * root.s;
        spacing: 16px * root.s;
        // 16:9 preview
        Rectangle {
            width: (root.height - 20px * root.s) * 16 / 9;
            border-radius: 8px * root.s;
            background: Palette.inset;
            border-width: 1px;
            border-color: Palette.outline;
            clip: true;
            if root.theme.has-thumb: Image {
                source: root.theme.thumb;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.theme.has-thumb: Icon {
                source: Icons.image;
                size: 36px;
                tint: Palette.text-lo;
            }
            if root.theme.has-bgm: Rectangle {
                x: 6px * root.s;
                y: 6px * root.s;
                width: bgm-row.preferred-width + 12px * root.s;
                height: 20px * root.s;
                border-radius: 5px * root.s;
                background: #000000b3;
                bgm-row := HorizontalLayout {
                    padding-left: 6px * root.s;
                    spacing: 3px * root.s;
                    Icon {
                        source: Icons.music-note;
                        size: 12px * root.s;
                        tint: Palette.success-text;
                    }
                    Text {
                        text: "BGM";
                        color: #ffffff;
                        font-size: max(8px, 11px * root.s);
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle {
                x: parent.width - self.width - 6px * root.s;
                y: parent.height - self.height - 6px * root.s;
                width: size-text.preferred-width + 10px * root.s;
                height: 18px * root.s;
                border-radius: 4px * root.s;
                background: #000000a0;
                size-text := Text {
                    text: root.theme.size;
                    color: #ffffffb0;
                    font-family: Palette.mono-font;
                    font-size: max(8px, 10px * root.s);
                }
            }
        }
        VerticalLayout {
            spacing: 3px * root.s;
            HorizontalLayout {
                spacing: 8px * root.s;
                // The title shrinks (elides) only when needed; the version sits
                // right after it and the spare width goes to the trailing spacer.
                Text {
                    text: root.theme.title;
                    color: Palette.text-hi;
                    font-size: max(12px, 17px * root.s);
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px * root.s;
                        width: ver.preferred-width + 10px * root.s;
                        border-radius: 4px * root.s;
                        background: root.selected ? Palette.primary.transparentize(70%) : transparent;
                        ver := Text {
                            text: "v" + root.theme.version;
                            color: root.selected ? Palette.accent : Palette.text-lo;
                            font-family: Palette.mono-font;
                            font-size: max(8px, 11px * root.s);
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 6px * root.s;
                Icon {
                    source: Icons.person;
                    size: 13px * root.s;
                    tint: Palette.accent;
                }
                Text {
                    text: root.theme.author;
                    color: Palette.accent;
                    font-size: max(9px, 12px * root.s);
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: "•";
                    color: Palette.text-lo;
                    font-size: max(9px, 12px * root.s);
                    vertical-alignment: center;
                }
                Text {
                    text: "Folder: " + root.theme.folder;
                    color: Palette.text-mid;
                    font-family: Palette.mono-font;
                    font-size: max(8px, 10.5px * root.s);
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.theme.summary;
                color: Palette.text-mid;
                font-size: max(9px, 12px * root.s);
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 6px * root.s;
                VerticalLayout {
                    alignment: center;
                    Tag {
                        scale: root.s * 0.82;
                        text: root.theme.pages + (root.theme.pages == 1 ? " Home Page" : " Home Pages");
                    }
                }
                if root.theme.icons > 0: VerticalLayout {
                    alignment: center;
                    Tag {
                        scale: root.s * 0.82;
                        text: root.theme.icons + " Custom Icons";
                    }
                }
                Text {
                    text: "Local Storage";
                    color: Palette.text-lo;
                    font-size: max(8px, 10.5px * root.s);
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                IconBtn {
                    icon: Icons.send-to-mobile;
                    tooltip: "Send to PS Vita";
                    clicked => { Library.send-to-vita(root.index); }
                }
                IconBtn {
                    icon: Icons.edit;
                    tooltip: "Edit theme";
                    clicked => { Library.edit(root.index); }
                }
                more := IconBtn {
                    icon: Icons.more-vert;
                    tooltip: "More";
                    clicked => { menu.show(); }
                }
            }
        }
    }
    menu := PopupWindow {
        x: root.width - 260px;
        y: root.height - 6px;
        width: 240px;
        Rectangle {
            background: Palette.surface1;
            border-radius: Palette.radius-control;
            border-width: 1px;
            border-color: #ffffff14;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                MenuItem {
                    text: "Extract BGM";
                    icon: Icons.download;
                    enabled: root.theme.has-bgm;
                    clicked => { Library.extract-bgm(root.index); }
                }
                MenuItem {
                    text: "Submit to Repository";
                    icon: Icons.cloud-upload;
                    enabled: Shell.online-available;
                    clicked => { Library.submit(root.index); }
                }
                MenuItem {
                    text: "Delete Theme";
                    icon: Icons.delete;
                    danger: true;
                    clicked => { Library.delete(root.index); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- inspector

component MetaTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> ok: false;
    in property <float> k: 1.0;   // panel fit factor
    border-radius: 10px * root.k;
    background: Palette.inset;
    min-height: 56px * root.k;
    VerticalLayout {
        padding: 10px * root.k;
        spacing: 3px * root.k;
        Text {
            text: root.label;
            color: Palette.text-lo;
            font-size: Type.label-sm * root.k;
            font-weight: 600;
            letter-spacing: 1px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 5px * root.k;
            if root.ok: Icon {
                source: Icons.check-circle;
                size: 15px * root.k;
                tint: Palette.success-text;
            }
            Text {
                text: root.value;
                color: root.ok ? Palette.success-text : Palette.text-hi;
                font-family: Palette.mono-font;
                font-size: Type.label-md * root.k;
                font-weight: 500;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}

component BgmPlayer inherits Rectangle {
    in property <float> k: 1.0;   // panel fit factor
    VerticalLayout {
        spacing: 8px * root.k;
        HorizontalLayout {
            spacing: 10px * root.k;
            Rectangle {
                width: 44px * root.k;
                height: 44px * root.k;
                border-radius: self.width / 2;
                background: play-touch.has-hover ? Palette.primary.brighter(15%) : Palette.primary;
                drop-shadow-blur: 12px;
                drop-shadow-color: Palette.primary.transparentize(50%);
                Icon {
                    source: Library.bgm-playing ? Icons.pause : Icons.play-arrow;
                    size: 24px * root.k;
                    tint: Palette.on-primary;
                }
                play-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Library.bgm-toggle-play(); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: Library.detail.bgm-name;
                    color: Palette.text-hi;
                    font-size: Type.body-md * root.k;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Library.detail.bgm-info;
                    color: Palette.text-mid;
                    font-size: Type.body-sm * root.k;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    scale: root.k;
                    icon: Icons.repeat;
                    active: Library.bgm-loop;
                    tooltip: "Loop";
                    clicked => { Library.bgm-toggle-loop(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconBtn {
                    scale: root.k;
                    icon: Icons.download;
                    tooltip: "Extract BGM";
                    clicked => { Library.extract-bgm(Library.selected); }
                }
            }
        }
        // Waveform + time
        Rectangle {
            height: 40px * root.k;
            border-radius: 8px * root.k;
            background: Palette.inset;
            HorizontalLayout {
                padding-left: 12px * root.k;
                padding-right: 12px * root.k;
                spacing: 10px * root.k;
                wave := Rectangle {
                    horizontal-stretch: 1;
                    for level[i] in Library.bgm-wave: Rectangle {
                        property <float> pos: i / max(1, Library.bgm-wave.length);
                        x: wave.width * root.pos-of(i);
                        width: max(2px, wave.width / max(1, Library.bgm-wave.length) - 2px);
                        height: max(3px, wave.height * 0.8 * level);
                        y: (wave.height - self.height) / 2;
                        border-radius: 1px;
                        background: self.pos <= Library.bgm-progress ? Palette.accent : Palette.text-lo.transparentize(40%);
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Library.bgm-seek(self.mouse-x / self.width); }
                    }
                }
                Text {
                    text: Library.bgm-time + " / " + Library.bgm-length;
                    color: Palette.text-mid;
                    font-family: Palette.mono-font;
                    font-size: Type.label-md * root.k;
                    vertical-alignment: center;
                }
            }
        }
    }
    pure function pos-of(i: int) -> float {
        i / max(1, Library.bgm-wave.length)
    }
}

component Inspector inherits Panel {
    property <bool> has: Library.selected >= 0 && Library.detail.valid;
    // Fit factor: everything in the panel scales by `k` so the whole inspector
    // fits the panel height without scrolling. `natural` is the content height at
    // k = 1 (constant, so there's no layout loop); scrolling remains a fallback
    // below the 0.6 legibility floor.
    property <length> natural: Library.detail.has-bgm ? 790px : 690px;
    property <float> k: max(0.5, min(1.0, root.height / root.natural));
    width: Density.narrow ? 340px : 420px;
    if !root.has: VerticalLayout {
        alignment: center;
        padding: 32px;
        spacing: 12px;
        Icon {
            source: Icons.visibility;
            size: 40px;
            tint: Palette.text-lo;
        }
        Text {
            text: "Select a theme to inspect it";
            color: Palette.text-mid;
            font-size: Type.body-md;
            horizontal-alignment: center;
        }
    }
    if root.has: ScrollView {
        content-width: self.visible-width;
        VerticalLayout {
            padding: (Density.narrow ? 14px : 20px) * root.k;
            spacing: 14px * root.k;
            // Stage header
            HorizontalLayout {
                spacing: 8px * root.k;
                Icon {
                    source: Icons.visibility;
                    size: 22px * root.k;
                    tint: Palette.accent;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    Text {
                        text: "LiveArea Stage";
                        color: Palette.text-hi;
                        font-size: Type.body-md * root.k;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: "960×544";
                        color: Palette.text-lo;
                        font-family: Palette.mono-font;
                        font-size: Type.label-sm * root.k;
                        overflow: elide;
                    }
                }
                // Close the inspector (deselect; the panel slides away).
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        scale: root.k;
                        icon: Icons.close;
                        tooltip: "Close";
                        clicked => { Library.select(-1); }
                    }
                }
            }
            // Stage view tabs on their own full-width row so the header never crowds.
            Rectangle {
                height: 36px * root.k;
                border-radius: 8px * root.k;
                background: Palette.inset;
                HorizontalLayout {
                    padding: 3px * root.k;
                    spacing: 2px * root.k;
                    Segment {
                        scale: root.k;
                        text: "Home";
                        min-width: 40px * root.k;
                        horizontal-stretch: 1;
                        selected: Library.stage-tab == 0;
                        clicked => { Library.stage-tab = 0; }
                    }
                    Segment {
                        scale: root.k;
                        text: "Lock";
                        min-width: 40px * root.k;
                        horizontal-stretch: 1;
                        selected: Library.stage-tab == 1;
                        clicked => { Library.stage-tab = 1; }
                    }
                    Segment {
                        scale: root.k;
                        text: "Icons";
                        min-width: 40px * root.k;
                        horizontal-stretch: 1;
                        selected: Library.stage-tab == 2;
                        clicked => { Library.stage-tab = 2; }
                    }
                }
            }
            // Stage: 960x544 aspect, panel width scaled by the fit factor (centred).
            stage-box := Rectangle {
                property <length> h: self.width * 544 / 960 * root.k;
                height: self.h;
            stage := Rectangle {
                x: (parent.width - self.width) / 2;
                width: parent.h * 960 / 544;
                height: parent.h;
                border-radius: 12px * root.k;
                background: #05070a;
                border-width: 1px;
                border-color: Palette.outline;
                clip: true;
                if Library.stage-tab == 0: Image {
                    source: Library.detail.home;
                    // FIT: whole image, letterboxed. 1:1: real pixels, centred.
                    width: Library.stage-fit ? parent.width : self.source.width * 1phx;
                    height: Library.stage-fit ? parent.height : self.source.height * 1phx;
                    image-fit: contain;
                }
                if Library.stage-tab == 1: Image {
                    source: Library.detail.lock;
                    width: Library.stage-fit ? parent.width : self.source.width * 1phx;
                    height: Library.stage-fit ? parent.height : self.source.height * 1phx;
                    image-fit: contain;
                }
                // FIT / 1:1 toggle, overlaid on the preview's corner
                if Library.stage-tab != 2: Rectangle {
                    x: parent.width - self.width - 8px * root.k;
                    y: parent.height - self.height - 8px * root.k;
                    width: fit-row.preferred-width;
                    height: 30px * root.k;
                    border-radius: 7px * root.k;
                    background: #000000b0;
                    fit-row := HorizontalLayout {
                        padding: 3px * root.k;
                        spacing: 2px * root.k;
                        Segment {
                            scale: root.k;
                            text: "FIT";
                            min-width: 36px * root.k;
                            selected: Library.stage-fit;
                            clicked => { Library.stage-fit = true; }
                        }
                        Segment {
                            scale: root.k;
                            text: "1:1";
                            min-width: 36px * root.k;
                            selected: !Library.stage-fit;
                            clicked => { Library.stage-fit = false; }
                        }
                    }
                }
                if Library.stage-tab == 2 && Library.detail.icons.length == 0: Text {
                    text: "This theme uses the default system icons";
                    color: Palette.text-mid;
                    font-size: Type.body-sm * root.k;
                }
                if Library.stage-tab == 2: Rectangle {
                    property <int> cols: 6;
                    property <length> cell: min((parent.width - 24px) / self.cols, (parent.height - 24px) / 3);
                    for icon[i] in Library.detail.icons: Image {
                        source: icon;
                        x: (parent.width - parent.cols * parent.cell) / 2 + mod(i, parent.cols) * parent.cell + (parent.cell - self.width) / 2;
                        y: (parent.height - 3 * parent.cell) / 2 + floor(i / parent.cols) * parent.cell + (parent.cell - self.height) / 2;
                        width: parent.cell * 0.82;
                        height: self.width;
                        image-fit: contain;
                    }
                }
            }
            }
            if Library.detail.has-bgm: BgmPlayer { k: root.k; }
            // Title block
            VerticalLayout {
                spacing: 4px * root.k;
                Text {
                    text: Library.detail.title;
                    color: Palette.text-hi;
                    font-size: (Type.headline-lg + 2px) * root.k;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 5px * root.k;
                    Text {
                        text: "Author:";
                        color: Palette.text-lo;
                        font-size: Type.body-md * root.k;
                    }
                    Text {
                        text: Library.detail.author;
                        color: Palette.text-hi;
                        font-size: Type.body-md * root.k;
                        overflow: elide;
                    }
                    Text {
                        text: "•  Version " + Library.detail.version;
                        color: Palette.text-lo;
                        font-size: Type.body-md * root.k;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // Meta grid
            GridLayout {
                spacing: 8px * root.k;
                Row {
                    MetaTile {
                        k: root.k;
                        label: "FORMAT STANDARD";
                        value: "Official SCE Theme";
                    }
                    MetaTile {
                        k: root.k;
                        label: "PACKAGE TARGET";
                        value: Library.detail.target;
                    }
                }
                Row {
                    MetaTile {
                        k: root.k;
                        label: "SYSTEM ICONS";
                        value: Library.detail.icons-text;
                        ok: Library.detail.icons.length > 0;
                    }
                    MetaTile {
                        k: root.k;
                        label: "THEME XML";
                        value: "theme.xml (Valid)";
                        ok: true;
                    }
                }
            }
            // Hotkey chips don't scale with the buttons, so they show only near
            // full size.
            Btn {
                scale: root.k;
                text: "Send to PS Vita";
                icon: Icons.send-to-mobile;
                has-icon: true;
                hotkey: root.k >= 0.9 ? "Ctrl+S" : "";
                trailing-arrow: true;
                kind: ButtonKind.primary;
                min-height: 48px * root.k;
                font-size: Type.body-lg;
                clicked => { Library.send-to-vita(Library.selected); }
            }
            HorizontalLayout {
                spacing: 8px * root.k;
                Btn {
                    scale: root.k;
                    text: "Edit Theme";
                    icon: Icons.edit;
                    has-icon: true;
                    hotkey: root.k >= 0.9 ? "Ctrl+E" : "";
                    horizontal-stretch: 1;
                    clicked => { Library.edit(Library.selected); }
                }
                Btn {
                    scale: root.k;
                    text: "Extract BGM";
                    icon: Icons.download;
                    has-icon: true;
                    hotkey: root.k >= 0.9 ? "Ctrl+X" : "";
                    horizontal-stretch: 1;
                    enabled: Library.detail.has-bgm;
                    clicked => { Library.extract-bgm(Library.selected); }
                }
            }
            HorizontalLayout {
                spacing: 8px * root.k;
                Btn {
                    scale: root.k;
                    text: "Submit to Repository";
                    icon: Icons.cloud-upload;
                    has-icon: true;
                    kind: ButtonKind.secondary;   // a real outlined button, not ghost text
                    enabled: Shell.online-available;
                    horizontal-stretch: 1;
                    clicked => { Library.submit(Library.selected); }
                }
                Btn {
                    scale: root.k;
                    text: "Delete Theme";
                    icon: Icons.delete;
                    has-icon: true;
                    hotkey: root.k >= 0.9 ? "Del" : "";
                    kind: ButtonKind.danger;
                    clicked => { Library.delete(Library.selected); }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- status bar

component StatusBar inherits Panel {
    height: Density.compact ? 52px : 64px;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 16px;
        Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: Palette.inset;
            Icon {
                source: Icons.memory;
                size: 22px;
                tint: Palette.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: "Theme Library";
                color: Palette.text-hi;
                font-size: Type.body-md;
                font-weight: 600;
            }
            Text {
                text: Library.total + " themes  •  " + Library.with-bgm + " with BGM  •  " + Library.total-size + " on disk";
                color: Palette.text-mid;
                font-size: Type.body-sm;
                overflow: elide;
            }
        }
        Rectangle {
            width: 1px;
            background: Palette.outline;
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: Shell.vita-address != "" ? Palette.accent : Palette.text-lo;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "Vita FTP";
                    color: Palette.text-mid;
                    font-size: Type.body-sm;
                }
                Text {
                    text: Shell.vita-address != "" ? Shell.vita-address : "Not configured";
                    color: Palette.text-hi;
                    font-family: Palette.mono-font;
                    font-size: Type.label-md;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "Configure FTP";
                icon: Icons.code;
                has-icon: true;
                clicked => { Library.configure-ftp(); }
            }
        }
    }
}

// ---------------------------------------------------------------- page

export component LibraryPage inherits Rectangle {
    public function focus-search() { bar.focus-search(); }
    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: Density.compact ? 12px : 20px;
        spacing: Density.compact ? 8px : 16px;
        bar := LibraryBar { }
        body := HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            // The list width once the inspector has finished opening/closing. Rows
            // size from this (not the animating width) so they don't re-lay out on
            // every frame of the slide.
            property <length> list-target: self.width - (Library.selected >= 0 ? insp-slot.full : 0px);
            Rectangle {
                horizontal-stretch: 1;
                if Library.themes.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    Icon {
                        source: Icons.wallpaper;
                        size: 48px;
                        tint: Palette.text-lo;
                    }
                    Text {
                        text: Library.total == 0 ? "Your theme library is empty" : "No themes match your search";
                        color: Palette.text-hi;
                        font-size: Type.headline-md;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Library.total == 0 ? "Create a new theme, import a .zip or folder, or download one from the Community Browser." : "Try a different search or filter.";
                        color: Palette.text-mid;
                        font-size: Type.body-md;
                        horizontal-alignment: center;
                    }
                }
                list := ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 10px;
                        for row[i] in Library.themes: ThemeCard {
                            theme: row;
                            index: i;
                            selected: i == Library.selected;
                            avail: body.list-target - 24px;
                        }
                    }
                }
            }
            // The inspector slides in from the right only while a theme is
            // selected; its slot's width animates, so the list shrinks to fit.
            insp-slot := Rectangle {
                property <bool> open: Library.selected >= 0;
                property <length> panel-w: Density.narrow ? 340px : 420px;
                property <length> gap: 20px;
                property <length> full: self.panel-w + self.gap;
                width: self.open ? self.full : 0px;
                animate width { duration: 220ms; easing: ease-in-out; }
                clip: true;
                Inspector {
                    x: parent.width - self.width;
                    width: insp-slot.panel-w;
                    height: parent.height;
                }
            }
        }
        StatusBar { }
    }
}
