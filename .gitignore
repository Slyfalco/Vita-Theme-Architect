# --- Build-generated modules (release builds only) ---
result/
secure_function*
secure_config*
cedist/

# --- Build output ---
build/
dist/
*.build/
*.onefile-build/
*.dist/
*.spec
nuitka-crash-report.xml

# --- Downloaded by setup_build.py / wine_builder.py ---
Tools/
VGAudioCli.exe
# at9tool.exe is Sony's proprietary tool (user-provided) — never commit/distribute it
at9tool.exe
*at9tool*

# --- Python ---
__pycache__/
*.py[cod]
*.pyd
*.so
# ...but DO track the bundled native at9codec libraries (they are shipped libs, not
# Python build artifacts); *.so above would otherwise silently drop the Linux ones.
!native/**/*.so
.venv/
venv/

# --- IDE ---
.idea/
.vscode/

# --- Local runtime data ---
crash.log
settings.json
Extras/
# Only the Template icons are kept from Themes/
Themes/*
!Themes/Template/
Themes/Template/*
!Themes/Template/icon_*.png

# --- Stale PyInstaller scripts (build is setup_build.py) ---
Compile.py
CompileAlt.py
.venv-x64/
.venv-arm64/
.venv-*/
build-logs/

# Local dev only: private-repo updater test token + launchers (NEVER commit)
.env
run-dev-token.ps1
run-dev-token.sh

# Native libsndfile for platforms with no soundfile wheel lib (e.g. Windows-ARM)
# is TRACKED per-arch under libsndfile/<os>-<arch>/ (built once, redistributable
# under its LGPL/BSD licenses) so every build can bundle it. Not ignored.

# --- Rust (v3) ---
target/
